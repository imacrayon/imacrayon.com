---
layout: layout.njk
title: Pictures
---

<header>
  <div class="center">
    <h1>Pictures</h1>
  </div>
</header>
<div class="center">
  <ul role="list" class="pictures stack" style="--gap:4rem;">
    {%- for picture in collections.pictures | reverse  %}
    <li>
      <img src="{{ picture.data.src }}" alt="{{ picture.data.alt }}">
      <strong><a href="{{ picture.url }}">{{ picture.data.title }}</a></strong>
    </li>
    {%- endfor %}
  </ul>
</div>

{% css %}
.pictures li {
  position: relative;
}

.pictures li:focus-within {
  outline: 2px solid var(--black);
  outline-offset: .5rem;
}

.pictures a {
  display: block;
  font-size: 1rem;
  margin-block-start: .25rem;
  text-decoration: underline;
  text-decoration-thickness: 1px;
}

.pictures a::before {
  content: '';
  position: absolute;
  inset: .5rem;
}

.pictures a:focus,
.pictures a:hover {
  text-decoration: underline;
  text-decoration-thickness: 1px;
}

.pictures a:focus {
  outline: none;
}
{% endcss %}
